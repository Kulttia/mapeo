# Postgres (Neon desde el Marketplace de Vercel). Vacío en local = PGlite en ~/.mapeo/pglite
DATABASE_URL=

# Opcional: otra carpeta para la base local (fuera de OneDrive)
PGLITE_DIR=

# Fase 1: proveedor de IA
ANTHROPIC_API_KEY=

# Fase 1: clave que habilita "Procesar con IA" en la app pública
MAPEO_CLAVE_PILOTO=

# Ingreso simulado del piloto (si se dejan vacías: usuario "prueba", contraseña "prueba")
MAPEO_USUARIO=
MAPEO_CLAVE=
# Opcional: secreto para firmar la cookie de sesión (si falta, se usa MAPEO_CLAVE_PILOTO)
MAPEO_SECRETO_SESION=
